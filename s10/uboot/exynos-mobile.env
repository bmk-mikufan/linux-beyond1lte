/*
 * Galaxy S10 (beyond1lte) boot environment: Ubuntu Server on the userdata
 * partition, U-Boot itself in the boot partition (no Android left).
 * Based on mobian/uboot/exynos-mobile.env (S10e).
 *
 * U-Boot loads /boot/s10/Image from the ext4 file system on userdata and
 * boots it with its own device tree. /boot/s10/bootargs.env (a line
 * "s10_args=...") replaces the default kernel arguments without a reflash.
 * Volume Down in U-Boot: menu.
 */
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootdelay=0
kernel_addr_r=0xa8000000
s10_image=Image

/* dp_altmode=0: a hub with HDMI keeps its USB lanes. autosuspend off: KVM
 * HID bridges and capture cards must not sleep. SuperSpeed stays off by
 * default as on the S10e (phy_exynos5_usbdrd.exynos9820_ss=1 turns it on). */
s10_args=console=tty0 loglevel=4 max77705.dp_altmode=0 usbcore.autosuspend=-1 phy_exynos5_usbdrd.exynos9820_ss=0 swiotlb=8192 panic=10

/* S-Boot picks recovery/download/normal from PMU INFORM registers that only
 * the Samsung kernel resets (see the S10e env); set them before every reset. */
s10_reason=setexpr.l s10_i2 *0x15860808 "&" 0xff00ffff;
	setexpr s10_i2 ${s10_i2} "|" 0x4e0000;
	mw.l 0x15860808 ${s10_i2};
	mw.l 0x15860810 ${s10_sysip};
	mw.l 0x1586080c ${s10_inform3}

s10_normal=setenv s10_sysip 0; setenv s10_inform3 0x12345670; run s10_reason

reboot_download=setenv s10_sysip 0; setenv s10_inform3 0x12345671;
	run s10_reason; reset

s10_find=if part number scsi 0 userdata s10_part; then
		echo "S10: userdata";
	else
		part number scsi 0 USERDATA s10_part;
	fi

s10_load=ufs init;
	scsi scan;
	run s10_find;
	part uuid scsi 0:${s10_part} s10_uuid;
	echo "S10: userdata = scsi 0:${s10_part} ${s10_uuid}";
	if load scsi 0:${s10_part} ${kernel_addr_r} /boot/s10/bootargs.env; then
		echo "S10: bootargs from /boot/s10/bootargs.env";
		env import -t ${kernel_addr_r} ${filesize} s10_args;
	fi;
	echo "S10: loading /boot/s10/${s10_image}";
	load scsi 0:${s10_part} ${kernel_addr_r} /boot/s10/${s10_image}

s10_boot=run s10_load &&
	setenv bootargs "root=PARTUUID=${s10_uuid} rootwait rw ${s10_args}" &&
	booti ${kernel_addr_r} - ${fdtcontroladdr}

bootcmd=mw.l 0x19030070 0x1281 1;
	run s10_normal;
	run s10_boot;
	echo "Boot failed. Any key: menu";
	pause;
	bootmenu

bootmenu_0=Ubuntu=run s10_boot
bootmenu_1=Ubuntu, previous kernel=setenv s10_image Image.prev; run s10_boot
bootmenu_2=Ubuntu, verbose=setenv s10_args "${s10_args} loglevel=8 ignore_loglevel"; run s10_boot
bootmenu_3=Download mode=run reboot_download
bootmenu_4=Console=echo "type: bootmenu"
bootmenu_5=Power off=run s10_normal; poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=mw.l 0x19030070 0x1281 1; bootmenu
