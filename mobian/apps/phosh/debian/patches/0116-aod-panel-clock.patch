+/* ---- the panel's clock ---- */
+
+/* One worker, in order: entering low power mode takes the panel ~150 ms, uploading the hands longer, and
+ * leaving it must not overtake a start still on its way. */
+typedef struct {
+  char     *path;
+  char     *value;
+  GWeakRef  aod;   /* told if the panel refuses its clock */
+} PanelWrite;
+
+static void panel_clock_failed (PhoshAod *self);
+
+
+static void
+panel_write_free (PanelWrite *w)
+{
+  g_weak_ref_clear (&w->aod);
+  g_free (w->path);
+  g_free (w->value);
+  g_free (w);
+}
+
+
+/* in the main thread: the last reference to the AOD may go here */
+static gboolean
+on_panel_clock_refused (gpointer data)
+{
+  PanelWrite *w = data;
+  g_autoptr (GObject) aod = g_weak_ref_get (&w->aod);
+
+  if (aod)
+    panel_clock_failed (PHOSH_AOD (aod));
+  panel_write_free (w);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+panel_write_func (gpointer data, gpointer unused)
+{
+  PanelWrite *w = data;
+  int fd = open (w->path, O_WRONLY | O_CLOEXEC);
+  int err = 0;
+
+  if (fd < 0 || write (fd, w->value, strlen (w->value)) < 0)
+    err = errno;
+  if (fd >= 0)
+    close (fd);
+  if (err)
+    g_message ("%s <- %s: %s", w->path, w->value, g_strerror (err));
+
+  if (err && g_str_has_suffix (w->path, "/self_clock"))
+    g_idle_add (on_panel_clock_refused, w);
+  else
+    panel_write_free (w);
+}
+
+
+static void
+panel_write (PhoshAod *self, const char *attr, const char *value)
+{
+  static GThreadPool *pool;
+  PanelWrite *w = g_new0 (PanelWrite, 1);
+
+  if (!pool)
+    pool = g_thread_pool_new (panel_write_func, NULL, 1, FALSE, NULL);
+  w->path = g_build_filename (self->panel, attr, NULL);
+  w->value = g_strdup (value);
+  /* not while it is disposed: leaving low power mode needs no answer */
+  g_weak_ref_init (&w->aod, g_str_equal (attr, "self_clock") ? self : NULL);
+  g_thread_pool_push (pool, w, NULL);
+}
+
+
+/* the panel whose clock this can run: both attributes writable (a udev rule gives them to the video group) */
+static char *
+find_panel_clock (void)
+{
+  glob_t g;
+  char *dir = NULL;
+
+  if (glob ("/sys/bus/mipi-dsi/devices/*/self_clock", 0, NULL, &g))
+    return NULL;
+  for (size_t i = 0; i < g.gl_pathc && !dir; i++) {
+    g_autofree char *d = g_path_get_dirname (g.gl_pathv[i]);
+    g_autofree char *lpm = g_build_filename (d, "lpm", NULL);
+
+    if (access (g.gl_pathv[i], W_OK) == 0 && access (lpm, W_OK) == 0)
+      dir = g_steal_pointer (&d);
+  }
+  globfree (&g);
+  return dir;
+}
+
+
+static int
+local_utc_offset (void)
+{
+  g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+
+  return g_date_time_get_utc_offset (now) / G_USEC_PER_SEC;
+}
+
+
+static gboolean
+dial_draw_cb (GtkWidget *dial, cairo_t *cr, PhoshAod *self)
+{
+  double s = phosh_monitor_get_fractional_scale (self->monitor);
+  double cx = gtk_widget_get_allocated_width (dial) / 2.0, cy = gtk_widget_get_allocated_height (dial) / 2.0;
+
+  cairo_set_source_rgb (cr, 0x6a / 255.0, 0x6a / 255.0, 0x6a / 255.0);
+  cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+  for (int i = 0; i < 12; i++) {
+    double a = i * G_PI / 6, in = (i % 3 ? DIAL_TICK_IN : DIAL_QUARTER_IN) / s;
+
+    cairo_set_line_width (cr, (i % 3 ? 3.0 : 6.0) / s);
+    cairo_move_to (cr, cx + in * sin (a), cy - in * cos (a));
+    cairo_line_to (cr, cx + DIAL_TICK_OUT / s * sin (a), cy - DIAL_TICK_OUT / s * cos (a));
+    cairo_stroke (cr);
+  }
+  cairo_arc (cr, cx, cy, DIAL_DOT / s, 0, 2 * G_PI);
+  cairo_fill (cr);
+  return FALSE;
+}
+
+
+static void
+show_panel_clock (PhoshAod *self, gboolean on)
+{
+  gtk_widget_set_visible (self->dial, on);
+  gtk_widget_set_visible (self->time, !on);
+}
+
+
+/* the dial's centre in panel pixels; FALSE if the panel is not upright */
+static gboolean
+dial_centre (PhoshAod *self, int *x, int *y)
+{
+  double s = phosh_monitor_get_fractional_scale (self->monitor);
+  int lx, ly;
+
+  if (phosh_monitor_get_transform (self->monitor) != PHOSH_MONITOR_TRANSFORM_NORMAL ||
+      !gtk_widget_get_mapped (self->dial) ||
+      !gtk_widget_translate_coordinates (self->dial, GTK_WIDGET (self),
+                                         gtk_widget_get_allocated_width (self->dial) / 2,
+                                         gtk_widget_get_allocated_height (self->dial) / 2, &lx, &ly))
+    return FALSE;
+  *x = (int) round (lx * s);
+  *y = (int) round (ly * s);
+  return TRUE;
+}
+
+
+static void
+start_panel_clock (PhoshAod *self)
+{
+  g_autofree char *clock = NULL;
+  int x, y;
+
+  if (!dial_centre (self, &x, &y)) {
+    panel_clock_failed (self);
+    return;
+  }
+  self->utcoff = local_utc_offset ();
+  clock = g_strdup_printf ("analog %d %d %d 24", x, y, self->utcoff);
+  if (!self->lpm)
+    panel_write (self, "lpm", AOD_LPM_NITS);
+  self->lpm = TRUE;
+  panel_write (self, "self_clock", clock);
+  self->running = TRUE;
+  g_debug ("panel clock at %d,%d", x, y);
+}
+
+
+static gboolean
+on_start_timeout (PhoshAod *self)
+{
+  self->start_id = 0;
+  start_panel_clock (self);
+  return G_SOURCE_REMOVE;
+}
+
+
+/* the panel refused its clock (no hand image, say), or it cannot be placed: the time as before */
+static void
+panel_clock_failed (PhoshAod *self)
+{
+  if (!self->use_clock)
+    return;
+  g_clear_handle_id (&self->start_id, g_source_remove);
+  self->use_clock = FALSE;
+  self->running = FALSE;
+  show_panel_clock (self, FALSE);
+  g_message ("the panel's clock is off, showing the time");
+}
+
+
+/**
+ * phosh_aod_set_shown:
+ * @self: The AOD
+ * @shown: Whether it is fully faded in
+ *
+ * Once the AOD is on the panel, the panel's clock starts (after a moment, for the frame to get there); as it
+ * starts to go, the panel leaves its low power mode.
+ */
+void
+phosh_aod_set_shown (PhoshAod *self, gboolean shown)
+{
+  g_return_if_fail (PHOSH_IS_AOD (self));
+
+  g_clear_handle_id (&self->start_id, g_source_remove);
+  if (shown && self->use_clock && !self->running) {
+    self->start_id = g_timeout_add (300, G_SOURCE_FUNC (on_start_timeout), self);
+  } else if (!shown && self->lpm) {
+    /* leaving low power mode stops the clock too */
+    panel_write (self, "lpm", "0");
+    self->lpm = FALSE;
+    self->running = FALSE;
+  }
+}
+
+
 static void
 update_clock (PhoshAod *self)
 {
@@ -65,6 +314,13 @@
   gtk_label_set_label (GTK_LABEL (self->time), phosh_wall_clock_get_clock (clock, TRUE));
   gtk_label_set_label (GTK_LABEL (self->date), date);
 
+  if (self->use_clock) {
+    /* the panel moves the picture itself; a new UTC offset (summer time) goes to its clock */
+    if (self->running && local_utc_offset () != self->utcoff)
+      start_panel_clock (self);
+    return;
+  }
+
   /* a slow walk around a small square, one step a minute */
   self->step = (self->step + 1) % 16;
   dx = ((int) (self->step % 4) - 2) * AOD_SHIFT / 2;
@@ -182,6 +438,16 @@
   gtk_widget_set_valign (self->box, GTK_ALIGN_START);
